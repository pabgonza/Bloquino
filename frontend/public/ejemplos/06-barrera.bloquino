 "fileGroups": {
  "group-arduino-uno": [
   {
    "name": "sketch.ino",
    "content": "// Generado desde bloques\n#include <Servo.h>\n\nfloat distancia = 0;\nServo servo3;\n\nfloat distanciaCm(int disparo, int eco) {\n  digitalWrite(disparo, LOW);\n  delayMicroseconds(2);\n  digitalWrite(disparo, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(disparo, LOW);\n  unsigned long eco_us = pulseIn(eco, HIGH, 25000);\n  if (eco_us == 0) {\n    return 400;\n  }\n  return eco_us / 58.0;\n}\n\nvoid setup() {\n  pinMode(12, OUTPUT);\n  pinMode(11, INPUT);\n  pinMode(5, OUTPUT);\n  pinMode(9, OUTPUT);\n  pinMode(8, OUTPUT);\n  servo3.attach(3);\n}\n\nvoid loop() {\n  distancia = distanciaCm(12, 11);\n  // El LED verde brilla más mientras más cerca está el auto\n  analogWrite(5, map(constrain(100 - distancia, 0, 100), 0, 100, 0, 255));\n  if (distancia < 20) {\n    servo3.write(90);\n    digitalWrite(9, LOW);\n    tone(8, 880);\n    delay(200);\n    noTone(8);\n  } else {\n    servo3.write(0);\n    digitalWrite(9, HIGH);\n  }\n  delay(100);\n}\n"
   },
