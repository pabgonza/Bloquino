    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques (avanzado: varios programas a la vez)\n// Cada programa es una función que avanza hasta su próxima espera y devuelve\n// el control; \"paso\" recuerda por dónde iba. Así ninguno frena a los demás.\n#define EMPEZAR() static int paso = 0; static unsigned long despierta = 0; switch (paso) { case 0:\n#define TERMINAR() } paso = -1\n#define CEDER() do { paso = __LINE__; return; case __LINE__:; } while (0)\n#define ESPERAR(ms) do { despierta = millis() + (unsigned long)(ms); paso = __LINE__; return; case __LINE__: if ((long)(millis() - despierta) < 0) return; } while (0)\n#define ESPERAR_HASTA(condicion) do { paso = __LINE__; case __LINE__: if (!(condicion)) return; } while (0)\n\nfloat espera = 0;\n#define ESPERAR_O_HASTA(ms, condicion) do { despierta = millis() + (unsigned long)(ms); paso = __LINE__; case __LINE__: if (!(condicion) && (long)(millis() - despierta) < 0) return; } while (0)\n\nString aTexto(float n) {\n  return n == (long)n ? String((long)n) : String(n);\n}\n\nvoid programa1() {\n  static float latido_segundos;\n  static int latido_vez;\n  EMPEZAR();\n  espera = 0.3;\n  while (true) {\n    if (espera > 3) {\n      // alarma\n      digitalWrite(13, HIGH);\n      tone(3, 880, 200);\n      ESPERAR(200);\n      digitalWrite(13, LOW);\n      ESPERAR(200);\n    } else {\n      // latido (segundos = espera)\n      latido_segundos = espera;\n      for (latido_vez = 0; latido_vez < 2; latido_vez++) {\n        digitalWrite(13, HIGH);\n        ESPERAR_O_HASTA(latido_segundos * 1000, espera > 3);\n        digitalWrite(13, LOW);\n        ESPERAR_O_HASTA(latido_segundos * 1000, espera > 3);\n      }\n      ESPERAR_O_HASTA(500, espera > 3);\n    }\n    CEDER();\n  }\n  TERMINAR();\n}\n\nvoid programa2() {\n  EMPEZAR();\n  while (true) {\n    ESPERAR_HASTA(digitalRead(7) == LOW);\n    ESPERAR(20);\n    Serial.println(String(\"Presionado, espera: \") + aTexto(espera));\n    espera += 1;\n    ESPERAR_HASTA(digitalRead(7) == HIGH);\n    ESPERAR(20);\n  }\n  TERMINAR();\n}\n\nvoid setup() {\n  pinMode(13, OUTPUT);\n  pinMode(3, OUTPUT);\n  pinMode(7, INPUT_PULLUP);\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  programa1();\n  programa2();\n}\n"
      },
