 "fileGroups": {
  "group-arduino-uno": [
   {
    "name": "sketch.ino",
    "content": "// Generado desde bloques (avanzado: varios programas a la vez)\n// Cada programa es una función que avanza hasta su próxima espera y devuelve\n// el control; \"paso\" recuerda por dónde iba. Así ninguno frena a los demás.\n#define EMPEZAR() static int paso = 0; static unsigned long despierta = 0; switch (paso) { case 0:\n#define TERMINAR() } paso = -1\n#define CEDER() do { paso = __LINE__; return; case __LINE__:; } while (0)\n#define ESPERAR(ms) do { despierta = millis() + (unsigned long)(ms); paso = __LINE__; return; case __LINE__: if ((long)(millis() - despierta) < 0) return; } while (0)\n#define ESPERAR_HASTA(condicion) do { paso = __LINE__; case __LINE__: if (!(condicion)) return; } while (0)\n\nfloat pulsaciones = 0;\n\nString aTexto(float n) {\n  return n == (long)n ? String((long)n) : String(n);\n}\n\nvoid programa1() {\n  EMPEZAR();\n  while (true) {\n    if (digitalRead(2) == LOW && digitalRead(3) == LOW) {\n      digitalWrite(13, HIGH);\n    } else {\n      digitalWrite(13, LOW);\n    }\n    if (digitalRead(2) == LOW || digitalRead(3) == LOW) {\n      digitalWrite(12, HIGH);\n    } else {\n      digitalWrite(12, LOW);\n    }\n    CEDER();\n  }\n  TERMINAR();\n}\n\nvoid programa2() {\n  EMPEZAR();\n  while (true) {\n    ESPERAR_HASTA(digitalRead(2) == LOW);\n    ESPERAR(20);\n    pulsaciones += 1;\n    if (pulsaciones == 10) {\n      pulsaciones = 0;\n    }\n    Serial.println(String(\"Pulsaciones: \") + aTexto(pulsaciones));\n    ESPERAR_HASTA(digitalRead(2) == HIGH);\n    ESPERAR(20);\n  }\n  TERMINAR();\n}\n\nvoid programa3() {\n  EMPEZAR();\n  while (true) {\n    ESPERAR_HASTA(digitalRead(3) == LOW);\n    ESPERAR(20);\n    ESPERAR_HASTA(digitalRead(3) == HIGH);\n    ESPERAR(20);\n    Serial.println(\"Soltaste el botón azul\");\n  }\n  TERMINAR();\n}\n\nvoid setup() {\n  pinMode(2, INPUT_PULLUP);\n  pinMode(3, INPUT_PULLUP);\n  pinMode(13, OUTPUT);\n  pinMode(12, OUTPUT);\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  programa1();\n  programa2();\n  programa3();\n}\n"
   },
