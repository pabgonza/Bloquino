    "name": "bloques.json",
    "content": "{\"blocks\":{\"languageVersion\":0,\"blocks\":[{\"type\":\"ab_al_iniciar\",\"id\":\"426F]iYsJN~%_{5,g,8i\",\"x\":30,\"y\":30,\"next\":{\"block\":{\"type\":\"ab_display4_preparar\",\"id\":\"/Xzjjf8s(z%IH|s_DghV\",\"fields\":{\"COMUN\":\"catodo\",\"A\":\"11\",\"B\":\"4\",\"C\":\"7\",\"D\":\"8\",\"E\":\"9\",\"F\":\"12\",\"G\":\"6\",\"D1\":\"10\",\"D2\":\"2\",\"D3\":\"3\",\"D4\":\"5\"},\"next\":{\"block\":{\"type\":\"ab_display_mostrar\",\"id\":\"Az7,zZvVV${x-(P?gjwm\",\"inputs\":{\"NUMERO\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"H-^}dcepQ#ffkO/fUdnu\",\"fields\":{\"NUM\":1234}}}},\"next\":{\"block\":{\"type\":\"ab_esperar\",\"id\":\"2u=Ca8m~UQ`D:2m/LfxK\",\"inputs\":{\"S\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"jWJm5E1y7B%/ahT,Ev7h\",\"fields\":{\"NUM\":2}}}},\"next\":{\"block\":{\"type\":\"ab_por_siempre\",\"id\":\"mMbfgrMn(iuqAB%)Ic5`\",\"inputs\":{\"DO\":{\"block\":{\"type\":\"ab_si_sino\",\"id\":\"DC@IhVPmQ4w.-ZYUEYJQ\",\"inputs\":{\"COND\":{\"block\":{\"type\":\"ab_serie_hay\",\"id\":\"0ZHCsLwaGn7JAz4N`ct]\"}},\"DO\":{\"block\":{\"type\":\"variables_set\",\"id\":\";yLB_!}vCH/5b,5s*:/)\",\"fields\":{\"VAR\":{\"id\":\"n\"}},\"inputs\":{\"VALUE\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"8!foyd!4rgwj,BugHvlj\",\"fields\":{\"NUM\":0}},\"block\":{\"type\":\"ab_serie_numero\",\"id\":\"LH(,pWlE=2w*.L,@GxAj\"}}},\"next\":{\"block\":{\"type\":\"ab_display_mostrar\",\"id\":\"|mm20+];d%{}_dnYVu.C\",\"inputs\":{\"NUMERO\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"*AX_U8=x)XDNlf)@UllS\",\"fields\":{\"NUM\":7}},\"block\":{\"type\":\"variables_get\",\"id\":\"nS+=mdw!Vc7tYGI,0tOB\",\"fields\":{\"VAR\":{\"id\":\"n\"}}}}},\"next\":{\"block\":{\"type\":\"ab_decir_seguido\",\"id\":\"i9(JeAe[b;c(LNNZj1=U\",\"inputs\":{\"VALOR\":{\"shadow\":{\"type\":\"text\",\"id\":\"fGSUOud`w9u.3rpCYSGY\",\"fields\":{\"TEXT\":\"Recibí el número \"}}}},\"next\":{\"block\":{\"type\":\"ab_decir\",\"id\":\"w!kex4!P;jC`ui7]LR[}\",\"inputs\":{\"VALOR\":{\"shadow\":{\"type\":\"text\",\"id\":\"Sl}^MrpV227?968?6q]@\",\"fields\":{\"TEXT\":\"\"}},\"block\":{\"type\":\"variables_get\",\"id\":\"[/uc]Ed~nZ0V;pWCUv)o\",\"fields\":{\"VAR\":{\"id\":\"n\"}}}}},\"next\":{\"block\":{\"type\":\"ab_esperar\",\"id\":\"i~WBr+2P3Bjy$wT?sywD\",\"inputs\":{\"S\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"u@-^gDM0UVK_F8^5PP)o\",\"fields\":{\"NUM\":3}}}}}}}}}}}}}},\"SINO\":{\"block\":{\"type\":\"ab_display_mostrar\",\"id\":\"XltmM{WT5}H+RE%j*dJy\",\"inputs\":{\"NUMERO\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"i=8DU3V|MMXh{(Y/Hlum\",\"fields\":{\"NUM\":7}},\"block\":{\"type\":\"ab_mapear\",\"id\":\"F}=hlqyj,Eux#Nz(8.i0\",\"inputs\":{\"X\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"mK[mE~6:~TD0nq^ti5Rj\",\"fields\":{\"NUM\":50}},\"block\":{\"type\":\"ab_perilla\",\"id\":\"T^-*RY|;yT_.-nAM@HjF\",\"fields\":{\"PIN\":\"A0\"}}},\"A\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"4]eFvjCTjMATG#N5A(+=\",\"fields\":{\"NUM\":0}}},\"B\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"3Ta^[F=8I/y:9#10q~C(\",\"fields\":{\"NUM\":100}}},\"C\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"N!mI!z9(Q_+ho{0$+BA~\",\"fields\":{\"NUM\":0}}},\"D\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"XfUjxTmN{^Q|h=LU!s(K\",\"fields\":{\"NUM\":9999}}}}}}}}}}}}}}}}}}}}}}]},\"variables\":[{\"name\":\"número\",\"id\":\"n\"}]}"
