  "group-arduino-uno": [
   {
    "name": "sketch.ino",
    "content": "// Generado desde bloques (avanzado: varios programas a la vez)\n// Cada programa es una función que avanza hasta su próxima espera y devuelve\n// el control; \"paso\" recuerda por dónde iba. Así ninguno frena a los demás.\n#define EMPEZAR() static int paso = 0; static unsigned long despierta = 0; switch (paso) { case 0:\n#define TERMINAR() } paso = -1\n#define CEDER() do { paso = __LINE__; return; case __LINE__:; } while (0)\n#define ESPERAR(ms) do { despierta = millis() + (unsigned long)(ms); paso = __LINE__; return; case __LINE__: if ((long)(millis() - despierta) < 0) return; } while (0)\n#define ESPERAR_HASTA(condicion) do { paso = __LINE__; case __LINE__: if (!(condicion)) return; } while (0)\n\nconst byte DISPLAY_SEGMENTOS[] = {11, 4, 7, 8, 9, 12, 6};\n// Segmentos de cada cifra: el bit 0 es el segmento A y el 6, el G.\nconst byte CIFRAS[] = {0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F};\nconst byte DISPLAY_DIGITOS[] = {10, 2, 3, 5};\nint displayNumero = -1;\nfloat numero = 0;\n\n// Enciende los segmentos de una cifra; con -1 los apaga todos.\nvoid mostrarCifra(int cifra) {\n  for (byte i = 0; i < 7; i++) {\n    bool prendido = cifra >= 0 && bitRead(CIFRAS[cifra], i);\n    digitalWrite(DISPLAY_SEGMENTOS[i], prendido ? HIGH : LOW);\n  }\n}\n\n// Muestra un dígito a la vez, tan rápido que se ven los cuatro encendidos.\nvoid refrescarDisplay() {\n  static byte turno = 0;\n  static unsigned long ultimo = 0;\n  if (micros() - ultimo < 2000) {\n    return;\n  }\n  ultimo = micros();\n  digitalWrite(DISPLAY_DIGITOS[turno], HIGH);\n  turno = (turno + 1) % 4;\n  int divisor = 1;\n  for (byte i = turno; i < 3; i++) {\n    divisor *= 10;\n  }\n  bool visible = displayNumero >= divisor || (turno == 3 && displayNumero >= 0);\n  mostrarCifra(visible ? displayNumero / divisor % 10 : -1);\n  digitalWrite(DISPLAY_DIGITOS[turno], LOW);\n}\n\nString leerTexto() {\n  String linea = Serial.readStringUntil('\\n');\n  linea.trim();\n  return linea;\n}\n\nvoid programa1() {\n  EMPEZAR();\n  displayNumero = constrain(1234, 0, 9999);\n  ESPERAR(2000);\n  while (true) {\n    if (Serial.available() > 0) {\n      numero = leerTexto().toFloat();\n      displayNumero = constrain(numero, 0, 9999);\n      Serial.print(\"Recibí el número \");\n      Serial.println(numero);\n      ESPERAR(3000);\n    } else {\n      displayNumero = constrain(map(map(analogRead(A0), 0, 1023, 0, 100), 0, 100, 0, 9999), 0, 9999);\n    }\n    CEDER();\n  }\n  TERMINAR();\n}\n\nvoid setup() {\n  for (byte i = 0; i < 7; i++) {\n    pinMode(DISPLAY_SEGMENTOS[i], OUTPUT);\n    digitalWrite(DISPLAY_SEGMENTOS[i], LOW);\n  }\n  for (byte i = 0; i < 4; i++) {\n    pinMode(DISPLAY_DIGITOS[i], OUTPUT);\n    digitalWrite(DISPLAY_DIGITOS[i], HIGH);\n  }\n  Serial.begin(9600);\n  Serial.setTimeout(50);\n}\n\nvoid loop() {\n  refrescarDisplay();\n  programa1();\n}\n"
   },
