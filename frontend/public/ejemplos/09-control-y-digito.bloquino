    "content": "{\"blocks\":{\"languageVersion\":0,\"blocks\":[{\"type\":\"ab_cuando_tecla\",\"id\":\"XMKK{cOL)K!`UQhW-#O?\",\"x\":30,\"y\":30,\"fields\":{\"TECLA\":\"*\",\"PIN\":\"10\"},\"next\":{\"block\":{\"type\":\"ab_display_preparar\",\"id\":\"#R:,L=aNW|,l4?#F:ba|\",\"fields\":{\"COMUN\":\"catodo\",\"A\":\"2\",\"B\":\"3\",\"C\":\"4\",\"D\":\"5\",\"E\":\"6\",\"F\":\"8\",\"G\":\"7\"},\"next\":{\"block\":{\"type\":\"ab_decir\",\"id\":\"|%j^/za^`+Gn|$YHciqG\",\"inputs\":{\"VALOR\":{\"shadow\":{\"type\":\"text\",\"id\":\"E`b$vy4_Ip3(OB29cI;%\",\"fields\":{\"TEXT\":\"\"}},\"block\":{\"type\":\"ab_unir\",\"id\":\"GhAqmH5vL`scjj0~t!c~\",\"inputs\":{\"A\":{\"shadow\":{\"type\":\"text\",\"id\":\"5muS23Bw~3Wh;(l2:;)O\",\"fields\":{\"TEXT\":\"\"}},\"block\":{\"type\":\"ab_tecla_ultima\",\"id\":\"Z]7IRM@TWT@lTkp8H$)|\",\"fields\":{\"PIN\":\"10\"}}},\"B\":{\"shadow\":{\"type\":\"text\",\"id\":\"fqKR3)^yLG1c1Uc-d$7l\",\"fields\":{\"TEXT\":\"\"}},\"block\":{\"type\":\"ab_unir\",\"id\":\"G_CPpv8g;PzVnjy#W*I~\",\"inputs\":{\"A\":{\"shadow\":{\"type\":\"text\",\"id\":\"GL?TKWW.{QU8.!|P:M]O\",\"fields\":{\"TEXT\":\" tiene el código \"}}},\"B\":{\"shadow\":{\"type\":\"text\",\"id\":\":8XPenE0JY_e;`E7AG0J\",\"fields\":{\"TEXT\":\"\"}},\"block\":{\"type\":\"ab_tecla_codigo\",\"id\":\"E|Kwdi1Xz2%jkk$;i*$x\",\"fields\":{\"PIN\":\"10\"}}}}}}}}}},\"next\":{\"block\":{\"type\":\"ab_comentario\",\"id\":\"HYy!z5KO.~m,8#-BmnzQ\",\"fields\":{\"TEXTO\":\"Una tecla que no es un número vale 0\"},\"next\":{\"block\":{\"type\":\"variables_set\",\"id\":\")0}@G}F;`yIjy~3s]DM2\",\"fields\":{\"VAR\":{\"id\":\"n\"}},\"inputs\":{\"VALUE\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"BetZXXVvD^;=5^}6#5(u\",\"fields\":{\"NUM\":0}},\"block\":{\"type\":\"ab_tecla_ultima\",\"id\":\"RpJmMnTS0eA[Q(]AE)rW\",\"fields\":{\"PIN\":\"10\"}}}},\"next\":{\"block\":{\"type\":\"ab_display_mostrar\",\"id\":\"TLJ+GJ}1.3O+^D19|?S-\",\"inputs\":{\"NUMERO\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"i0__NiiIv[joB,khX9