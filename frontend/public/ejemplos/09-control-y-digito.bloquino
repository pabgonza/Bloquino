  "group-arduino-uno": [
   {
    "name": "sketch.ino",
    "content": "// Generado desde bloques (avanzado: varios programas a la vez)\n#define IR_RECEIVE_PIN 10\n#define NO_LED_FEEDBACK_CODE\n#include <TinyIRReceiver.hpp>\n\n// Cada programa es una función que avanza hasta su próxima espera y devuelve\n// el control; \"paso\" recuerda por dónde iba. Así ninguno frena a los demás.\n#define EMPEZAR() static int paso = 0; static unsigned long despierta = 0; switch (paso) { case 0:\n#define TERMINAR() } paso = -1\n#define CEDER() do { paso = __LINE__; return; case __LINE__:; } while (0)\n#define ESPERAR(ms) do { despierta = millis() + (unsigned long)(ms); paso = __LINE__; return; case __LINE__: if ((long)(millis() - despierta) < 0) return; } while (0)\n#define ESPERAR_HASTA(condicion) do { paso = __LINE__; case __LINE__: if (!(condicion)) return; } while (0)\n\nconst byte DISPLAY_SEGMENTOS[] = {2, 3, 4, 5, 6, 8, 7};\n// Segmentos de cada cifra: el bit 0 es el segmento A y el 6, el G.\nconst byte CIFRAS[] = {0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F};\nint teclaControl = -1;\nunsigned int teclasRecibidas = 0;\nfloat numero = 0;\n\n// Enciende los segmentos de una cifra; con -1 los apaga todos.\nvoid mostrarCifra(int cifra) {\n  for (byte i = 0; i < 7; i++) {\n    bool prendido = cifra >= 0 && bitRead(CIFRAS[cifra], i);\n    digitalWrite(DISPLAY_SEGMENTOS[i], prendido ? HIGH : LOW);\n  }\n}\n\nString nombreTecla(int codigo) {\n  switch (codigo) {\n    case 69: return \"1\";\n    case 70: return \"2\";\n    case 71: return \"3\";\n    case 68: return \"4\";\n    case 64: return \"5\";\n    case 67: return \"6\";\n    case 7: return \"7\";\n    case 21: return \"8\";\n    case 9: return \"9\";\n    case 22: return \"silencio\";\n    case 25: return \"0\";\n    case 13: return \"borrar\";\n    case 24: return \"función\";\n    case 8: return \"autoprueba\";\n    case 28: return \"OK\";\n    case 90: return \"reinicio\";\n    case 82: return \"volver\";\n  }\n  return \"\";\n}\n\nString aTexto(float n) {\n  return n == (long)n ? String((long)n) : String(n);\n}\n\nvoid programa1() {\n  static unsigned int vistas = 0;\n  EMPEZAR();\n  while (true) {\n    ESPERAR_HASTA(teclasRecibidas != vistas);\n    vistas = teclasRecibidas;\n    Serial.println(nombreTecla(teclaControl) + (String(\" tiene el código \") + aTexto(teclaControl)));\n    // Una tecla que no es un número vale 0\n    numero = String(nombreTecla(teclaControl)).toFloat();\n    mostrarCifra(abs((int)(numero)) % 10);\n    vistas = teclasRecibidas;\n  }\n  TERMINAR();\n}\n\nvoid programa2() {\n  static unsigned int vistas = 0;\n  EMPEZAR();\n  while (true) {\n    ESPERAR_HASTA(teclasRecibidas != vistas);\n    vistas = teclasRecibidas;\n    if (teclaControl == 13) {\n      mostrarCifra(-1);\n      vistas = teclasRecibidas;\n    }\n  }\n  TERMINAR();\n}\n\nvoid programa3() {\n  static int i;\n  static unsigned int vistas = 0;\n  EMPEZAR();\n  while (true) {\n    ESPERAR_HASTA(teclasRecibidas != vistas);\n    vistas = teclasRecibidas;\n    if (teclaControl == 28) {\n      for (i = 0; i <= 9; i++) {\n        mostrarCifra(abs((int)(i)) % 10);\n        ESPERAR(300);\n      }\n      vistas = teclasRecibidas;\n    }\n  }\n  TERMINAR();\n}\n\nvoid setup() {\n  for (byte i = 0; i < 7; i++) {\n    pinMode(DISPLAY_SEGMENTOS[i], OUTPUT);\n    digitalWrite(DISPLAY_SEGMENTOS[i], LOW);\n  }\n  Serial.begin(9600);\n  initPCIInterruptForTinyReceiver();\n}\n\nvoid loop() {\n  if (TinyReceiverDecode() && TinyIRReceiverData.Flags != IRDATA_FLAGS_IS_REPEAT) {\n    teclaControl = TinyIRReceiverData.Command;\n    teclasRecibidas++;\n  }\n  programa1();\n  programa2();\n  programa3();\n}\n"
   },
