  "group-arduino-uno": [
   {
    "name": "sketch.ino",
    "content": "// Generado desde bloques\nvoid setup() {\n  pinMode(13, OUTPUT);\n  pinMode(11, OUTPUT);\n  pinMode(12, OUTPUT);\n}\n\nvoid loop() {\n  // Rojo: los autos esperan\n  digitalWrite(13, HIGH);\n  delay(2000);\n  digitalWrite(13, LOW);\n  // Verde: los autos pasan\n  digitalWrite(11, HIGH);\n  delay(2000);\n  digitalWrite(11, LOW);\n  // Amarillo: parpadea 3 veces\n  for (int vez = 0; vez < 3; vez++) {\n    digitalWrite(12, HIGH);\n    delay(300);\n    digitalWrite(12, LOW);\n    delay(300);\n  }\n}\n"
   },
