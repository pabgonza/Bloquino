  "group-arduino-uno": [
   {
    "name": "sketch.ino",
    "content": "// Generado desde bloques\n#include <Servo.h>\n\nfloat valor = 0;\nServo servo9;\n\nvoid setup() {\n  pinMode(11, OUTPUT);\n  servo9.attach(9);\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  valor = map(analogRead(A0), 0, 1023, 0, 100);\n  servo9.write(map(valor, 0, 100, 0, 180));\n  analogWrite(11, map(valor, 0, 100, 0, 255));\n  Serial.println(valor);\n  delay(100);\n}\n"
   },
