  "fileGroups": {
    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid color(float r, float g, float b) {\n  analogWrite(11, 255 - r);\n  analogWrite(10, 255 - g);\n  analogWrite(9, 255 - b);\n}\n\nvoid parpadear(float veces) {\n  for (int vez = 0; vez < veces; vez++) {\n    color(255, 255, 255);\n    delay(200);\n    color(0, 0, 0);\n    delay(200);\n  }\n}\n\nvoid setup() {\n  pinMode(11, OUTPUT);\n  pinMode(10, OUTPUT);\n  pinMode(9, OUTPUT);\n  parpadear(3);\n}\n\nvoid loop() {\n  color(255, 0, 0);\n  delay(1000);\n  color(0, 255, 0);\n  delay(1000);\n  color(0, 0, 255);\n  delay(1000);\n}\n"
      },
