  "group-arduino-uno": [
   {
    "name": "sketch.ino",
    "content": "// Generado desde bloques (avanzado: varios programas a la vez)\n// Cada programa es una función que avanza hasta su próxima espera y devuelve\n// el control; \"paso\" recuerda por dónde iba. Así ninguno frena a los demás.\n#define EMPEZAR() static int paso = 0; static unsigned long despierta = 0; switch (paso) { case 0:\n#define TERMINAR() } paso = -1\n#define CEDER() do { paso = __LINE__; return; case __LINE__:; } while (0)\n#define ESPERAR(ms) do { despierta = millis() + (unsigned long)(ms); paso = __LINE__; return; case __LINE__: if ((long)(millis() - despierta) < 0) return; } while (0)\n#define ESPERAR_HASTA(condicion) do { paso = __LINE__; case __LINE__: if (!(condicion)) return; } while (0)\n\nString orden = \"\";\n\nString leerTexto() {\n  String linea = Serial.readStringUntil('\\n');\n  linea.trim();\n  return linea;\n}\n\nvoid programa1() {\n  EMPEZAR();\n  analogWrite(11, 255);\n  analogWrite(10, 255);\n  analogWrite(9, 255);\n  Serial.println(\"Escribe: rojo, verde, azul, azar o apagar\");\n  TERMINAR();\n}\n\nvoid programa2() {\n  EMPEZAR();\n  while (true) {\n    ESPERAR_HASTA(Serial.available() > 0);\n    orden = leerTexto();\n    if (orden == \"rojo\") {\n      analogWrite(11, 255);\n      analogWrite(10, 0);\n      analogWrite(9, 0);\n    }\n    if (orden == \"verde\") {\n      analogWrite(11, 0);\n      analogWrite(10, 255);\n      analogWrite(9, 0);\n    }\n    if (orden == \"azul\") {\n      analogWrite(11, 0);\n      analogWrite(10, 0);\n      analogWrite(9, 255);\n    }\n    if (orden == \"apagar\") {\n      analogWrite(11, 0);\n      analogWrite(10, 0);\n      analogWrite(9, 0);\n    }\n    if (orden == \"azar\") {\n      // Cada color queda encendido (255) o apagado (0)\n      analogWrite(11, random(0, 2) * 255);\n      analogWrite(10, random(0, 2) * 255);\n      analogWrite(9, random(0, 2) * 255);\n    }\n    Serial.println(String(\"Recibido: \") + orden);\n    CEDER();\n  }\n  TERMINAR();\n}\n\nvoid setup() {\n  pinMode(11, OUTPUT);\n  pinMode(10, OUTPUT);\n  pinMode(9, OUTPUT);\n  Serial.begin(9600);\n  Serial.setTimeout(50);\n}\n\nvoid loop() {\n  programa1();\n  programa2();\n}\n"
   },
