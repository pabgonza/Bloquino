 "fileGroups": {
  "group-arduino-uno": [
   {
    "name": "sketch.ino",
    "content": "// Generado desde bloques\nvoid setup() {\n  pinMode(2, INPUT);\n  pinMode(13, OUTPUT);\n  pinMode(9, OUTPUT);\n}\n\nvoid loop() {\n  // El botón une el pin 2 con 5V; la resistencia de 10 kΩ lo deja en BAJA al soltarlo\n  if (digitalRead(2)) {\n    digitalWrite(13, HIGH);\n  } else {\n    digitalWrite(13, LOW);\n  }\n  // La perilla da de 0 a 1023 y el brillo va de 0 a 255\n  analogWrite(9, (float)analogRead(A0) / 4);\n}\n"
   },
   {
    "name": "bloques.json",
    "content": "{\"blocks\":{\"languageVersion\":0,\"blocks\":[{\"type\":\"ab_al_iniciar\",\"id\":\"aRy?F=i.3KGbWu-JezI:\",\"x\":30,\"y\":30,\"next\":{\"block\":{\"type\":\"ab_por_siempre\",\"id\":\"}=Y7=2lfn^@2_%*`yLbE\",\"inputs\":{\"DO\":{\"block\":{\"type\":\"ab_comentario\",\"id\":\"qg253_pDs,bahR$Bq~Rl\",\"fields\":{\"TEXTO\":\"El botón une el pin 2 con 5V; la resistencia de 10 kΩ lo deja en BAJA al soltarlo\"},\"next\":{\"block\":{\"type\":\"ab_si_sino\",\"id\":\"7Aa0:g`ZwhARM=}0ey?J\",\"inputs\":{\"COND\":{\"block\":{\"type\":\"ab_leer_digital\",\"id\":\"0e,4;2X0R!oCnn0!Uli2\",\"fields\":{\"PIN\":\"2\"}}},\"DO\":{\"block\":{\"type\":\"ab_pin_digital\",\"id\":\"4qRRitKSbtW},wu/yQxf\",\"fields\":{\"PIN\":\"13\",\"ESTADO\":\"HIGH\"}}},\"SINO\":{\"block\":{\"type\":\"ab_pin_digital\",\"id\":\"=+*S[0uL)3~]-3]O[8:M\",\"fields\":{\"PIN\":\"13\",\"ESTADO\":\"LOW\"}}}},\"next\":{\"block\":{\"type\":\"ab_comentario\",\"id\":\"_Ig]^3dN3uc:eiESA,m4\",\"fields\":{\"TEXTO\":\"La perilla da de 0 a 1023 y el brillo va de 0 a 255\"},\"next\":{\"block\":{\"type\":\"ab_pin_pwm\",\"id\":\"rzvl?lyIGXuA-]OIKHN6\",\"fields\":{\"PIN\":\"9\"},\"inputs\":{\"VALOR\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"Y:$MLtBiE:SMBREiN%lS\",\"fields\":{\"NUM\":255}},\"block\":{\"type\":\"ab_aritmetica\",\"id\":\"Z~DK8kd9Hn],qo.R.?Xm\",\"fields\":{\"OP\":\"/\"},\"inputs\":{\"A\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"R=?7:X%B/qs3}:tP*$oT\",\"fields\":{\"NUM\":1}},\"block\":{\"type\":\"ab_leer_analogico\",\"id\":\"~sLP*_!Y/.YS]N*.CLZt\",\"fields\":{\"PIN\":\"A0\"}}},\"B\":{\"shadow\":{\"type\":\"math_number\",\"id\":\"einNMj6GTaIRV$?u?a{@\",\"fields\":{\"NUM\":4}}}}}}}}}}}}}}}}}}}]}}"
