  "group-arduino-uno": [
   {
    "name": "sketch.ino",
    "content": "// Generado desde bloques\n#include <LiquidCrystal.h>\n#include <DHT.h>\n\nLiquidCrystal lcd(12, 11, 5, 4, 3, 2);\nDHT dht13(13, DHT11);\n\nString aTexto(float n) {\n  return n == (long)n ? String((long)n) : String(n);\n}\n\nvoid setup() {\n  lcd.begin(16, 2);\n  dht13.begin();\n  lcd.print(\"Hola Bloquino\");\n  delay(2000);\n  lcd.clear();\n}\n\nvoid loop() {\n  lcd.setCursor(0, 0);\n  lcd.print(String(\"Temp: \") + aTexto(dht13.readTemperature()));\n  lcd.setCursor(0, 1);\n  lcd.print(String(\"Hum: \") + aTexto(dht13.readHumidity()));\n  lcd.setCursor(10, 0);\n  if (dht13.readTemperature() > 30) {\n    lcd.print(\"CALOR\");\n  } else {\n    lcd.print(\"     \");\n  }\n  delay(500);\n}\n"
   },
