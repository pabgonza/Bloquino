  "group-arduino-uno": [
   {
    "name": "sketch.ino",
    "content": "// Generado desde bloques (avanzado: varios programas a la vez)\n#include <BuzzerMusic.h>\n\n// Cada programa es una función que avanza hasta su próxima espera y devuelve\n// el control; \"paso\" recuerda por dónde iba. Así ninguno frena a los demás.\n#define EMPEZAR() static int paso = 0; static unsigned long despierta = 0; switch (paso) { case 0:\n#define TERMINAR() } paso = -1\n#define CEDER() do { paso = __LINE__; return; case __LINE__:; } while (0)\n#define ESPERAR(ms) do { despierta = millis() + (unsigned long)(ms); paso = __LINE__; return; case __LINE__: if ((long)(millis() - despierta) < 0) return; } while (0)\n#define ESPERAR_HASTA(condicion) do { paso = __LINE__; case __LINE__: if (!(condicion)) return; } while (0)\n\nBuzzerMusic musica8(8);\n\nvoid programa1() {\n  EMPEZAR();\n  // Saludo de tres notas\n  tone(8, 262, 200);\n  ESPERAR(200);\n  tone(8, 330, 200);\n  ESPERAR(200);\n  tone(8, 392, 400);\n  ESPERAR(400);\n  noTone(8);\n  TERMINAR();\n}\n\nvoid programa2() {\n  EMPEZAR();\n  while (true) {\n    ESPERAR_HASTA(digitalRead(2) == LOW);\n    ESPERAR(20);\n    musica8.start(BuzzerMusic::ODE_TO_JOY);\n    while (musica8.isPlaying()) {\n      digitalWrite(13, HIGH);\n      ESPERAR(200);\n      digitalWrite(13, LOW);\n      ESPERAR(200);\n      CEDER();\n    }\n    ESPERAR_HASTA(digitalRead(2) == HIGH);\n    ESPERAR(20);\n  }\n  TERMINAR();\n}\n\nvoid programa3() {\n  EMPEZAR();\n  while (true) {\n    ESPERAR_HASTA(digitalRead(3) == LOW);\n    ESPERAR(20);\n    if (musica8.isPlaying()) {\n      musica8.stop();\n    } else {\n      musica8.start(BuzzerMusic::HAPPY_BIRTHDAY);\n      ESPERAR_HASTA(!musica8.isPlaying());\n    }\n    ESPERAR_HASTA(digitalRead(3) == HIGH);\n    ESPERAR(20);\n  }\n  TERMINAR();\n}\n\nvoid setup() {\n  pinMode(8, OUTPUT);\n  pinMode(2, INPUT_PULLUP);\n  pinMode(13, OUTPUT);\n  pinMode(3, INPUT_PULLUP);\n}\n\nvoid loop() {\n  musica8.update();\n  programa1();\n  programa2();\n  programa3();\n}\n"
   },
