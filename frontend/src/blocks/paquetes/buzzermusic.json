{
  "libreria": {
    "nombre": "BuzzerMusic",
    "version": "1.1.0",
    "origen": "https://github.com/pabgonza/BuzzerMusic.git",
    "commit": "7742b6c5ae98efbe638d852e875cbe742ccb5dd0"
  },
  "categoria": "sonido",
  "include": "#include <BuzzerMusic.h>",
  "global": "BuzzerMusic musica{PIN}({PIN});",
  "tick": "musica{PIN}.update();",
  "porDefecto": { "VELOCIDAD": "NORMAL", "PIN": "8" },
  "menus": {
    "CANCION": [
      { "texto": "Mario Bros", "valor": "MARIO_BROS", "metodo": "marioBros", "tempo": "200" },
      { "texto": "Marcha Imperial", "valor": "IMPERIAL_MARCH", "metodo": "imperialMarch", "tempo": "120" },
      { "texto": "Cumpleaños feliz", "valor": "HAPPY_BIRTHDAY", "metodo": "happyBirthday", "tempo": "140" },
      { "texto": "Himno de la Alegría", "valor": "ODE_TO_JOY", "metodo": "odeToJoy", "tempo": "114" }
    ],
    "VELOCIDAD": [
      { "texto": "muy lenta", "valor": "MUY_LENTA", "factor": "0.5" },
      { "texto": "lenta", "valor": "LENTA", "factor": "0.75" },
      { "texto": "normal", "valor": "NORMAL" },
      { "texto": "rápida", "valor": "RAPIDA", "factor": "1.25" },
      { "texto": "muy rápida", "valor": "MUY_RAPIDA", "factor": "1.5" }
    ]
  },
  "bloques": [
    {
      "tipo": "ab_tocar_cancion",
      "texto": "tocar canción %1 a velocidad %2 en pin %3",
      "campos": ["CANCION", "VELOCIDAD", "PIN"],
      "codigo": "musica{PIN}.start(BuzzerMusic::{CANCION}, {CANCION.tempo*VELOCIDAD.factor});",
      "tick": true,
      "esperarHasta": "!musica{PIN}.isPlaying()",
      "bloqueante": "musica{PIN}.{CANCION.metodo}({CANCION.tempo*VELOCIDAD.factor});"
    },
    {
      "tipo": "ab_empezar_cancion",
      "texto": "empezar canción %1 a velocidad %2 en pin %3",
      "campos": ["CANCION", "VELOCIDAD", "PIN"],
      "codigo": "musica{PIN}.start(BuzzerMusic::{CANCION}, {CANCION.tempo*VELOCIDAD.factor});",
      "tick": true
    },
    {
      "tipo": "ab_detener_cancion",
      "texto": "detener canción en pin %1",
      "campos": ["PIN"],
      "codigo": "musica{PIN}.stop();"
    },
    {
      "tipo": "ab_cancion_sonando",
      "texto": "¿canción sonando en pin %1?",
      "campos": ["PIN"],
      "forma": "logico",
      "codigo": "musica{PIN}.isPlaying()"
    }
  ]
}
