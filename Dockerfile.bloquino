# Imagen de Bloquino para la sala: la página ya compilada, el backend de
# compilación, arduino-cli, el core del UNO y las librerías del kit.
# Sin ESP32, RP2040, QEMU ni chips propios (eso es Dockerfile.standalone).
#   docker compose -f docker-compose.bloquino.yml up -d --build
# Guía: docs/bloquino-dia-de-clase.md

# ---- Página ----
FROM node:24-slim AS pagina
WORKDIR /app/frontend
COPY frontend/package.json ./
COPY frontend/scripts/ scripts/
RUN npm install --no-audit --no-fund
COPY frontend/ .
RUN npx vite build

# ---- Imagen final ----
FROM python:3.12-slim

# Versiones con las que se probó el curso.
ARG ARDUINO_CLI=1.5.1
ARG CORE_AVR=1.8.8

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates nginx \
 && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default \
 && curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh \
    | BINDIR=/usr/local/bin sh -s ${ARDUINO_CLI}

RUN arduino-cli core update-index \
 && arduino-cli core install arduino:avr@${CORE_AVR} \
 && arduino-cli cache clean

# Librerías del kit (sed: en Windows los archivos pueden llegar con CRLF).
COPY scripts/librerias-kit.txt scripts/instalar-librerias.sh /tmp/kit/
RUN sed -i 's/\r$//' /tmp/kit/* \
 && sh /tmp/kit/instalar-librerias.sh \
 && arduino-cli cache clean \
 && rm -rf /tmp/kit

# Backend de Velxio entero, con sus dependencias de Python tal como las declara.
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app/ app/

# Al arrancar, el backend registra los índices de otras placas y los pide a
# internet. Se hace aquí una vez para que queden en la imagen y la sala
# funcione sin conexión. De paso se comprueba que el backend arranca y queda
# compilado el core del UNO: la primera compilación de la clase no lo espera.
COPY backend/board-indexes/package_*.json /root/.arduino15/
RUN python -c "import app.main" \
 && mkdir /tmp/calentar \
 && printf 'void setup() {}\nvoid loop() {}\n' > /tmp/calentar/calentar.ino \
 && arduino-cli compile --fqbn arduino:avr:uno /tmp/calentar \
 && rm -rf /tmp/calentar

COPY --from=pagina /app/frontend/dist /usr/share/nginx/html
COPY docker/bloquino-nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/bloquino-entrypoint.sh /app/entrypoint.sh
RUN sed -i 's/\r$//' /app/entrypoint.sh

EXPOSE 80 443
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
  CMD curl -fs http://localhost/health || exit 1
CMD ["bash", "/app/entrypoint.sh"]
