{"format":"velxio-project","version":1,"exportedAt":"","name":"sala","boards":[{"id":"arduino-uno","boardKind":"arduino-uno","x":50,"y":50,"activeFileGroupId":"group-arduino-uno","languageMode":"arduino","serialBaudRate":0}],"fileGroups":{"group-arduino-uno":[{"name":"sketch.ino","content":"// Generado desde bloques (avanzado: varios programas a la vez)\n// Cada programa es una función que avanza hasta su próxima espera y devuelve\n// el control; \"paso\" recuerda por dónde iba. Así ninguno frena a los demás.\n#define EMPEZAR() static int paso = 0; static unsigned long despierta = 0; switch (paso) { case 0:\n#define TERMINAR() } paso = -1\n#define CEDER() do { paso = __LINE__; return; case __LINE__:; } while (0)\n#define ESPERAR(ms) do { despierta = millis() + (unsigned long)(ms); paso = __LINE__; return; case __LINE__: if ((long)(millis() - despierta) < 0) return; } while (0)\n#define ESPERAR_HASTA(condicion) do { paso = __LINE__; case __LINE__: if (!(condicion)) return; } while (0)\n\nString orden = \"\";\n\nString leerTexto() {\n  String linea = Serial.readStringUntil('\\n');\n  linea.trim();\n  return linea;\n}\n\nvoid programa1() {\n  EMPEZAR();\n  while (true) {\n    ESPERAR_HASTA(Serial.available() > 0);\n    orden = leerTexto();\n    if (orden == \"encender\") {\n      digitalWrite(13, HIGH);\n    } else {\n      digitalWrite(13, LOW);\n    }\n    Serial.println(String(\"Recibido: \") + orden);\n    CEDER();\n  }\n  TERMINAR();\n}\n\nvoid setup() {\n  pinMode(13, OUTPUT);\n  Serial.begin(9600);\n  Serial.setTimeout(50);\n}\n\nvoid loop() {\n  programa1();\n}\n"},{"name":"bloques.json","content":"{\"blocks\":{\"languageVersion\":0,\"blocks\":[{\"type\":\"ab_cuando_serie\",\"id\":\"$zxpiZNT~H=:W[N-flJu\",\"x\":30,\"y\":30,\"next\":{\"block\":{\"type\":\"ab_definir_texto\",\"id\":\"B}lHUbbhlARP@|LFcA?E\",\"fields\":{\"VAR\":{\"id\":\"t\"}},\"inputs\":{\"VALUE\":{\"block\":{\"type\":\"ab_serie_texto\",\"id\":\"=p%qvhj0R|jy$rE|#*(=\"}}},\"next\":{\"block\":{\"type\":\"ab_si_sino\",\"id\":\"/aXMQ^g.;cBR.4Gky8Ql\",\"inputs\":{\"COND\":{\"block\":{\"type\":\"ab_texto_igual\",\"id\":\"n,aJ@YcoaGH,Y0Rpw^{a\",\"inputs\":{\"A\":{\"block\":{\"type\":\"ab_variable_texto\",\"id\":\"Up!0QIBN=Kk34Ph|*KHC\",\"fields\":{\"VAR\":{\"id\":\"t\"}}}},\"B\":{\"block\":{\"type\":\"text\",\"id\":\")7,glRXR6/JrsM;56ewQ\",\"fields\":{\"TEXT\":\"encender\"}}}}}},\"DO\":{\"block\":{\"type\":\"ab_led\",\"id\":\"f~Ca~S~.L7gTb,4PgAf:\",\"fields\":{\"ESTADO\":\"HIGH\",\"PIN\":\"13\"}}},\"SINO\":{\"block\":{\"type\":\"ab_led\",\"id\":\"c5`l?McF!bzXC+Ev5rZi\",\"fields\":{\"ESTADO\":\"LOW\",\"PIN\":\"13\"}}}},\"next\":{\"block\":{\"type\":\"ab_decir\",\"id\":\",FoM.Qut[.BxO,oZb-I*\",\"inputs\":{\"VALOR\":{\"block\":{\"type\":\"ab_unir\",\"id\":\"WEuS~6!7@Ysa|7IAzv5S\",\"inputs\":{\"A\":{\"block\":{\"type\":\"text\",\"id\":\"-oLPN1!E?tmQs$=-dWas\",\"fields\":{\"TEXT\":\"Recibido: \"}}},\"B\":{\"block\":{\"type\":\"ab_variable_texto\",\"id\":\"JLIdp+`6Tdc,-2P[k]s7\",\"fields\":{\"VAR\":{\"id\":\"t\"}}}}}}}}}}}}}}}]},\"variables\":[{\"name\":\"orden\",\"id\":\"t\",\"type\":\"texto\"}]}"}]},"components":[],"wires":[],"activeBoardId":"arduino-uno"}